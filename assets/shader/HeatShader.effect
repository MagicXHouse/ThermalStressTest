CCEffect %{
  techniques:
  - name: transparent
    passes:
    - vert: heat-vs:vert
      frag: heat-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one          # 加法混合，多层会累加
          blendDstAlpha: one
      rasterizerState:
        cullMode: none
      properties:
        heatTint: { value: [1.0, 0.35, 0.1, 0.55], editor: { type: color } }
}%

CCProgram heat-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif

  in vec3 a_position;
  in vec2 a_texCoord;

  out vec2 v_uv;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    v_uv = a_texCoord;
    return cc_matViewProj * pos;
  }
}%

CCProgram heat-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>

  uniform Constant {
    vec4 heatTint;
  };

  in vec2 v_uv;

  vec4 frag () {
    vec2 uv = v_uv + vec2(cc_time.x * 0.05, -cc_time.x * 0.03);

    // ALU 依赖链：纯乘加，饱和 ALU 管线（不用 sin/cos）
    float x = fract(uv.x * 127.1 + uv.y * 311.7);
    float y = fract(uv.y * 269.5 + uv.x * 183.3);
    for (int i = 0; i < 512; i++) {
      x = fract(x * 1.61803 + y * 0.75488 + 0.12345);
      y = fract(y * 1.61803 + x * 0.75488 + 0.54321);
    }

    float t = clamp(x + y - 1.0, 0.0, 1.0);
    vec3 cold = vec3(0.05, 0.10, 0.55);
    vec3 hot  = vec3(1.0, 0.25, 0.05);
    return vec4(mix(cold, hot, t), heatTint.a);
  }
}%

